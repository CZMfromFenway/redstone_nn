!03_phase3_quantized_network/results/annotated_layout.png
!03_phase3_quantized_network/results/signal_maps_4cases.png

# ── webapp：52 MB → 只留 6 个定案件 ────────
02_phase2_avatar/webapp/*.json
!02_phase2_avatar/webapp/pca22_dim4w64L1_model.json
!02_phase2_avatar/webapp/colour_k8snap_model.json
!02_phase2_avatar/webapp/scorer_quad.json
