!02_phase2_avatar/webapp/styles_gauss.json
!02_phase2_avatar/webapp/style_envelopes.json
02_phase2_avatar/webapp/sandbox_standalone.html
02_phase2_avatar/webapp/*.png

# ── 6 MB 级中间量（可重算）──────────────────
03_phase3_quantized_network/results/planes_L2.json
03_phase3_quantized_network/results/towers_L2.json
03_phase3_quantized_network/results/planes64_relu.json
02_phase2_avatar/audit_tmp/tree_compare.json
00_shared/archive_dt_*/data/DT_binary_compiler_*.csv

# ── 本地草稿 ───────────────────────────────
*.tmp
*.bak
~$*

# ═════════════════════════════════════════════
# 四期：只收「文档引用到的图 + 部署权重 + 盲测标签」
#   训练产物（可重训）、采样池（可重采）、过程稿一律不入库
# ═════════════════════════════════════════════
04_phase4_colour_avatar/_work/
# （_work/digest/ 的四份摘要已入库：它们是 docs/00 引用的整理留档；其余过程稿忽略）

# 实验臂的训练产物（一批 3.5 MB，重训命令见 docs/13 §9）
04_phase4_colour_avatar/results/train/
04_phase4_colour_avatar/results/colourise/model_*.json

# 扩散权重（单份最大 7.9 MB，可重训）与样本池（可重采）；只留代理指标
04_phase4_colour_avatar/results/diffusion/*.json
!04_phase4_colour_avatar/results/diffusion/*_stats.json

# 两阶段实验臂：只留部署必需的灰度模型与颜色头
04_phase4_colour_avatar/results/twostage/*.json
!04_phase4_colour_avatar/results/twostage/gray_pca4.json
!04_phase4_colour_avatar/results/twostage/pal16_curated64.json

# 过程稿（下划线开头 = 中间产物；`sample_baselines.py --verify` 会自动重生成）
04_phase4_colour_avatar/results/labels/_*.json

